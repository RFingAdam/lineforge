* text=auto eol=lf

# Source code: always LF
*.py text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.txt text eol=lf
*.pyi text eol=lf

# Shell scripts: LF (so they work on Linux)
*.sh text eol=lf

# Windows-specific scripts: CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.tiff binary
*.tif binary
*.ico binary
*.whl binary
*.so binary
*.dylib binary
*.dll binary
*.exe binary
